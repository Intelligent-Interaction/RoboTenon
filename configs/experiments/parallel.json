{
  "parameters": {
    "runtime": {
      "execution": {
        "backend": "process",
        "max_workers": 2,
        "gpu_ids": ["0", "1"],
        "max_retries": 0,
        "startup_timeout_s": 180,
        "task_timeout_s": 1800,
        "shutdown_timeout_s": 15,
        "recycle_after_tasks": 50,
        "memory_mode": "snapshot"
      },
      "web": {"enabled": true, "host": "127.0.0.1", "port": 8765}
    }
  }
}
