{
  "backend": "../tool/xiaomi/vla.py",
  "backend_config": "../tool/xiaomi/config.json",
  "model_devices": "0,1,2,3,4,5,6,7",
  "workers_per_gpu": 16,
  "batch_size": 8,
  "wait_ms": 50,
  "scheduling_strategy": "global_queue",
  "scheduler_seed": 7,
  "trace_mode": "summary",
  "history_cache": "auto",
  "batch_services": [
    {
      "name": "reasoner",
      "factory": "robotenon_qwen_reasoner.backend:Provider",
      "params": {
        "model_path": "/models/Qwen3-VL-4B-Instruct",
        "max_new_tokens": 1024
      },
      "devices": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ],
      "max_batch_size": 8,
      "max_wait_ms": 50
    }
  ]
}
