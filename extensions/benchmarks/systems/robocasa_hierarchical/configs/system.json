{
  "config_version": 1,
  "graphs_config": "graphs.json",
  "plugin_modules": [
    "robotenon.modules.plan",
    "robotenon_robocasa_system.modules"
  ],
  "modules": [
    {
      "id": "plan",
      "name": "plan",
      "kind": "planner"
    },
    {
      "id": "robocasa_system_plan",
      "name": "robocasa_system_plan",
      "kind": "planner"
    },
    {
      "id": "robocasa_system_action",
      "name": "robocasa_system_action",
      "kind": "agent"
    },
    {
      "id": "robocasa_system_verify",
      "name": "robocasa_system_verify",
      "kind": "evaluator"
    },
    {
      "id": "robocasa_system_terminal",
      "name": "robocasa_system_terminal",
      "kind": "evaluator"
    },
    {
      "id": "native_benchmark_terminal",
      "name": "native_benchmark_terminal",
      "kind": "evaluator"
    }
  ],
  "plugin_tools": [
    "robotenon_benchmark_support.model_tool"
  ],
  "tools": [
    {
      "id": "planner",
      "name": "benchmark_model",
      "kind": "model",
      "params": {
        "service": "planner",
        "timeout_s": 600
      }
    },
    {
      "id": "verifier",
      "name": "benchmark_model",
      "kind": "model",
      "params": {
        "service": "verifier",
        "timeout_s": 600
      }
    }
  ],
  "parameters": {
    "runtime": {
      "graph_id": "xr365_single_task_reference",
      "monitor_enabled": false
    },
    "model": {
      "hlp_tool": "planner",
      "verify_tool": "verifier",
      "vla_tool": "policy"
    },
    "policy": {
      "planner_stop_requires_environment_success": true
    }
  }
}
