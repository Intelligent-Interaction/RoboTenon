+
+    refs, peaks = [], []
+
+    class Backend:
+        max_workers = 1
+
+        async def execute(self, configured, case, context):
+            gc.collect()
+            peaks.append(sum(ref() is not None for ref in refs))
+            payload = LargeContext(observations=["x" * 100000])
+            refs.append(weakref.ref(payload))
+            return {
+                "task_success": True,
+                "context": payload,
+                "ltm_summary": {"case": case.index},
