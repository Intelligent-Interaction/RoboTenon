+    manager._dispatch_waiting()
+    restored = JobStore(manager.output_root)
+    assert restored["queued-000"]["status"] == "running"
+    assert restored["queued-000"]["pid"] == process.pid
+    assert restored["queued-001"]["status"] == "waiting"
