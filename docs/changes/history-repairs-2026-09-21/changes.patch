+            "job_id": key,
+            "status": "waiting",
+            "submitted_at": f"{number:06}",
+            "command": ["fake-runner"],
+            "log_path": str(root / f"{key}.log"),
+        }
+    process = SimpleNamespace(pid=987654, poll=lambda: None)
+    monkeypatch.setattr(
+        "robosys.web.experiments.subprocess.Popen", lambda *args, **kwargs: process
+    )
+    monkeypatch.setattr(
+        "robosys.runtime.processes.register_process",
+        lambda *args, **kwargs: {"pid": process.pid},
