+"""Expected-behaviour regressions for the independent 2026-09-20 audit."""
+import asyncio
+import json
+import threading
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+from test_execution_backends import make_config
+
+from robosys.infra.params import Params
+from robosys.modules.verify import VerifyModule
+from robosys.runtime.experiment import ExperimentRequest, run_experiment
+from robosys.runtime.runner import EpisodeRequest
+from robosys.runtime.worker import WorkerRuntime
+
+
+@pytest.mark.parametrize('output', [None, {}, {'subtask_success': 'false'},
+    {'subtask_success': 'true'}, {'subtask_success': 0}, {'subtask_success': 1},
+    {'subtask_success': None}, {'subtask_success': []}, {'subtask_success': {}},
+    {'subtask_success': True, 'physical_belief_update': []}])
+def test_verifier_rejects_invalid_output_without_mutating_memory(output):
+    async def scenario():
+        async def tool(*args):
+            return SimpleNamespace(ok=True, output=output, metadata={})
+        ctx = SimpleNamespace(inputs={'instruction': 'pick'}, values={'unchanged': True}, feedback=None,
+            params=Params({'model': {'hlp_tool': 'fake'}, 'task': {'task_id': 'pick'}}), call_tool=tool)
+        with pytest.raises(ValueError, match='verifier'):
+            await VerifyModule().run(ctx)
+        assert ctx.values == {'unchanged': True}
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize('success', [False, True])
+def test_verifier_accepts_only_actual_boolean(success):
+    async def scenario():
+        async def tool(*args):
+            return SimpleNamespace(ok=True, output={'subtask_success': success}, metadata={})
+        ctx = SimpleNamespace(inputs={'instruction': 'pick'}, values={}, feedback=None,
+            params=Params({'model': {'hlp_tool': 'fake'}, 'task': {'task_id': 'pick'}}), call_tool=tool)
+        result = await VerifyModule().run(ctx)
+        assert result['subtask_success'] is success
+        assert result['stm']['completed'] == (['pick'] if success else [])
+        assert result['stm']['remaining'] == ([] if success else ['pick'])
+    asyncio.run(scenario())
+
+
+def test_worker_uses_snapshot_after_config_file_changes(tmp_path):
+    async def scenario():
+        config = make_config(tmp_path, trials=1)
+        value = json.loads(config.read_text())
+        value['modules'][0]['params'] = {'prefix': 'before'}
+        value['graphs'][0]['outputs']['marker'] = 'nodes.echo.outputs.prefix'
+        config.write_text(json.dumps(value))
+        request = EpisodeRequest(config=config, output=tmp_path/'episode.json')
