+def test_real_robot_sync_sdk_is_isolated_from_watchdog_and_deadline():
+    import time
+    from robosys.bodies.real_robot_body import RealRobotBody
+    from robosys.runtime.safety import SafetyStateStore
+    from robosys.schemas import Action, ActionChunk
+    async def scenario():
+        release = threading.Event()
+        calls, ticks = [], []
+        loop_thread = threading.get_ident()
+        class Driver:
+            def connect(self): calls.append(('connect', threading.get_ident()))
+            def execute(self, action):
+                calls.append(('execute', threading.get_ident()))
+                release.wait(3)
+            def hold(self, reason):
+                calls.append(('hold', threading.get_ident()))
+                release.set()
+            def close(self): calls.append(('close', threading.get_ident()))
+        body = RealRobotBody(driver=Driver(), safety_state=SafetyStateStore(), stop_timeout_s=.2)
+        session = uuid4()
+        asyncio.get_running_loop().call_later(.01, lambda: ticks.append(time.monotonic()))
+        started = time.monotonic()
+        try:
+            result = await asyncio.wait_for(body.execute(ActionChunk(session_id=session,
+                actions=[Action(session_id=session, timeout_ms=25)])), 1)
+            assert result.deadline_exceeded and result.status == 'failed'
+            assert ticks and ticks[0] - started < .2
+            assert [name for name, _ in calls].count('hold') == 1
+        finally:
+            release.set()
+            await body.close()
+        assert all(tid != loop_thread for _, tid in calls)
+        assert len({tid for name, tid in calls if name in {'connect', 'execute', 'close'}}) == 1
+    asyncio.run(scenario())
+
