+def test_linux_process_identity_uses_boot_and_start_tick_without_ps(tmp_path, monkeypatch):
+    from pathlib import Path
+    from robosys.runtime import processes
+    (tmp_path/'self').mkdir()
+    (tmp_path/'self/stat').write_text('')
+    (tmp_path/'sys/kernel/random').mkdir(parents=True)
+    (tmp_path/'sys/kernel/random/boot_id').write_text('boot-id')
+    for pid, state in [(101, 'S'), (102, 'Z')]:
+        (tmp_path/str(pid)).mkdir()
+        fields = [state, '1', '101'] + ['0']*16 + ['98765']
+        (tmp_path/str(pid)/'stat').write_text(f'{pid} (name with ) bracket) ' + ' '.join(fields))
+    actual_path = Path
+    monkeypatch.setattr(processes, 'Path', lambda value: tmp_path / str(value).removeprefix('/proc/').removeprefix('/proc')
+        if str(value).startswith('/proc') else actual_path(value))
+    monkeypatch.setattr(processes.subprocess, 'run', lambda *a, **k: pytest.fail('Linux must not need ps'))
+    assert processes.process_table() == {101: {'pid': 101, 'ppid': 1, 'pgid': 101, 'start': 'boot-id:98765'}}
+
