+def test_portal_authentication_protects_read_and_control_http_endpoints():
+    import http.client
+    from robosys.web.server import build_server
+    calls = []
+    manager = SimpleNamespace(shutdown_all=lambda **kwargs: calls.append(kwargs) or {'count': 0})
+    server = build_server('127.0.0.1', 0, SimpleNamespace(traces=None),
+        experiment_manager=manager, control_token='secret-for-test')
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    def request(method, path, auth=None):
+        client = http.client.HTTPConnection('127.0.0.1', server.server_port, timeout=2)
+        try:
+            headers = {'Content-Type': 'application/json'}
+            if auth: headers['Authorization'] = auth
+            client.request(method, path, body='{}' if method == 'POST' else None, headers=headers)
+            response = client.getresponse()
+            result = response.status, response.getheader('WWW-Authenticate'), response.read()
+            return result
+        finally: client.close()
+    try:
+        assert request('GET', '/')[0:2] == (401, 'Basic realm="RoboSys Portal", charset="UTF-8"')
+        assert request('POST', '/api/system/shutdown')[0] == 401
+        assert calls == []
+        assert request('POST', '/api/system/shutdown', 'Bearer secret-for-test')[0] == 200
+        assert len(calls) == 1
+        assert request('GET', '/', 'Bearer secret-for-test')[0] == 200
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join()
+
