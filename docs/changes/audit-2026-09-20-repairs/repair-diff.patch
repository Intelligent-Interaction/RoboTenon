+def test_multiseed_cases_have_independent_running_slots(tmp_path):
+    from robosys.task_adapters.base import BaseTaskAdapter, ConfiguredTaskAdapter, TaskCase
+    from robosys.task_adapters.evaluator import evaluate_task_adapters
+    async def scenario():
+        gate, fast_done = asyncio.Event(), asyncio.Event()
+        calls, finished = [], []
+        class Adapter(BaseTaskAdapter):
+            def enumerate_cases(self, *, adapter_id, params):
+                for index, seed in enumerate((10, 20)):
+                    yield TaskCase(adapter_id=adapter_id, task_id='same', environment_id='fake', index=index, seed=seed)
+        class Backend:
+            max_workers = 2
+            async def execute(self, configured, case, context):
+                calls.append(case.index)
+                if case.index == 0:
+                    await gate.wait()
+                else:
+                    fast_done.set()
+                finished.append(case.index)
+                return {'task_success': True}
+        configured = ConfiguredTaskAdapter('adapter', SimpleNamespace(name='fixture'), Adapter())
+        task = asyncio.create_task(evaluate_task_adapters(config_path=tmp_path/'config.json', params=Params({}),
+            adapters=[configured], output_dir=tmp_path, run_id='seeds', run_episode=None,
+            execution_backend=Backend(), options={'memory_mode': 'disabled'}))
+        try:
+            await asyncio.wait_for(fast_done.wait(), 1)
+            await asyncio.sleep(.15)
+            assert not task.done()
+            gate.set()
+            result = await asyncio.wait_for(task, 1)
+            assert result['num_completed'] == result['successes'] == 2
+            assert sorted(calls) == sorted(finished) == [0, 1]
+        finally:
+            gate.set()
+            if not task.done(): task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+    asyncio.run(scenario())
