+        for _ in range(2):
+            with pytest.raises(RuntimeError, match='must be replaced'):
+                await worker.run_task(request)
+        with pytest.raises(RuntimeError, match='replacement process required'):
+            await worker.close()
+        assert events == ['start', 'close']
+    asyncio.run(scenario())
+
