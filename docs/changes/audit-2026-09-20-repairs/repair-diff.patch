+def test_idempotency_rejects_changed_payload_and_accepts_identical_retry(tmp_path, durable):
+    from robosys.runtime.safety import SafetyStateStore
+    from robosys.services.body import InProcessBodyService
+    from robosys.schemas import Action, ActionChunk
+    async def scenario():
+        calls = []
+        async def execute(action): calls.append(action.payload)
+        def new_body():
+            return InProcessBodyService(execute, safety_state=SafetyStateStore(),
+                idempotency_db=tmp_path/'actions.sqlite3' if durable else None)
+        body = new_body()
+        session = uuid4()
+        async def run(payload, key='same'):
+            return await body.execute(ActionChunk(session_id=session,
+                actions=[Action(session_id=session, idempotency_key=key, payload=payload)]))
+        try:
+            first = await run({'target': [1, 2], 'speed': 1})
+            assert first.status == 'succeeded'
+            if durable:
+                await body.close()
+                body = new_body()
+            retry = await run({'speed': 1, 'target': [1, 2]})
+            assert retry.status == 'succeeded' and retry.executed_actions == 0
+            conflict = await run({'speed': 1, 'target': [3, 4]})
+            assert conflict.status == 'rejected' and 'idempotency_conflict' in conflict.error
+            assert len(calls) == 1
+            assert (await run({'target': [3, 4]}, key='new')).status == 'succeeded'
+            assert len(calls) == 2
+        finally: await body.close()
+    asyncio.run(scenario())
