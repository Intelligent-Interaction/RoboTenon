+"""Preview/apply artifact retention or rebuild an episode index for a legacy run."""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from robosys.runtime.retention import RetentionPolicy, _terminal_lease, prune_artifacts
+from robosys.task_adapters.evaluator import _compact_episode
+from robosys.task_adapters.result_index import ResultIndex
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-root", default="data/experiments")
+    parser.add_argument(
+        "--policy", help="JSON with logs_days, traces_days, videos_days and failed_days"
+    )
+    parser.add_argument(
+        "--apply",
+        action="store_true",
+        help="delete eligible artifacts; otherwise preview only",
+    )
+    parser.add_argument(
+        "--index-run",
+        help="rebuild the query index for a terminal run (does not prune artifacts)",
+    )
+    args = parser.parse_args()
+    if args.index_run:
+        root = Path(args.index_run).resolve()
+        with _terminal_lease(root) as safe:
+            if not safe:
+                parser.error(
+                    "run is active, queued for resume, or has no verifiable run lease"
+                )
+            summary = json.loads((root / "summary.json").read_text())
+            from robosys.web.experiments import ExperimentManager
+
+            records = [
+                dict(
+                    item,
+                    adapter_id=adapter,
+                    global_index=ExperimentManager._episode_index(item, seq),
+                )
+                for seq, (adapter, item) in enumerate(
+                    ExperimentManager._iter_summary_episodes(summary)
+                )
+            ]
+            ResultIndex(root).initialize(_compact_episode(item) for item in records)
+            status_path = root / "status.json"
+            if status_path.exists():
+                from robosys.task_adapters.evaluator import write_json
+
+                status = json.loads(status_path.read_text())
+                status["summary"] = ExperimentManager._compact_summary(summary)
+                write_json(status_path, status)
+        print(
+            json.dumps(
+                {"indexed": len(records), "path": str(root / "episodes.sqlite3")}
+            )
+        )
+    else:
+        policy = RetentionPolicy(
+            **(json.loads(Path(args.policy).read_text()) if args.policy else {})
+        )
+        print(
+            json.dumps(
+                prune_artifacts(args.output_root, policy, apply=args.apply),
+                ensure_ascii=False,
+                indent=2,
+            )
+        )
+
+
+if __name__ == "__main__":
+    main()
