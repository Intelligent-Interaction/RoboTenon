+"""One opt-in retention policy for terminal-run logs, traces and videos.
+
+Never follows symlinks, removes run metadata, or prunes a run with a held lease,
+queued resume, or a surviving owned process. Dry-run is the default.
+"""
+
+import fcntl
+import json
+import time
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+
+from .processes import owned_processes
+
+
+@dataclass(frozen=True)
+class RetentionPolicy:
+    logs_days: int = 30
+    traces_days: int = 30
+    videos_days: int = 7
+    failed_days: int = 90
+
+    def __post_init__(self):
+        if any(type(value) is not int or value < 1 for value in vars(self).values()):
+            raise ValueError("retention days must be positive integers")
+
+
+@contextmanager
+def _terminal_lease(root):
+    lock = root / ".control" / "run.lock"
+    if not lock.is_file() or lock.is_symlink():
+        yield False
+        return
+    with lock.open("r+") as handle:
+        try:
+            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield False
+            return
+        try:
+            yield not (
+                root / ".control" / "resume.json"
+            ).exists() and not owned_processes(root / ".processes")
+        finally:
+            fcntl.flock(handle, fcntl.LOCK_UN)
+
+
+def prune_artifacts(
+    output_root, policy, *, apply=False, now=None, budget_s=5, max_entries=20000
+):
+    output_root = Path(output_root).resolve()
+    report = {
+        "applied": apply,
+        "files": [],
+        "bytes": 0,
+        "skipped_runs": [],
+        "truncated": False,
+    }
+    jobs_file = output_root / "jobs.json"
+    if not jobs_file.is_file():
+        return report
+    jobs = json.loads(jobs_file.read_text())
+    jobs = jobs.values() if isinstance(jobs, dict) else jobs
+    deadline, now = time.monotonic() + budget_s, time.time() if now is None else now
+    inspected = 0
+    for job in jobs:
+        if inspected >= max_entries or time.monotonic() >= deadline:
+            report["truncated"] = True
+            break
+        if job.get("status") not in {"completed", "failed", "cancelled"}:
+            continue
+        root = Path(job["output_root"])
+        if (
+            root.is_symlink()
+            or root.resolve().parent != output_root
+            or not root.is_dir()
+        ):
+            continue
+        with _terminal_lease(root) as safe:
+            if not safe:
+                report["skipped_runs"].append(job["job_id"])
+                continue
+            stack = [root]
+            external_log = output_root / (job["job_id"] + ".log")
+            candidates = [external_log] if external_log.is_file() else []
+            while stack:
+                directory = stack.pop()
+                for path in directory.iterdir():
+                    inspected += 1
+                    if inspected >= max_entries or time.monotonic() >= deadline:
+                        report["truncated"] = True
+                        stack.clear()
+                        break
+                    if path.is_symlink() or any(
+                        part in {".control", ".processes"}
+                        for part in path.relative_to(root).parts
+                    ):
+                        continue
+                    if path.is_dir():
+                        stack.append(path)
+                    elif path.is_file():
+                        candidates.append(path)
+            for path in candidates:
+                if time.monotonic() >= deadline:
+                    report["truncated"] = True
+                    break
+                if path.is_symlink():
+                    continue
+                relative = path.relative_to(output_root)
+                if path.suffix.lower() in {".mp4", ".webm", ".avi"}:
+                    days = policy.videos_days
+                elif path.suffix == ".log" or path.name in {"stdout.txt", "stderr.txt"}:
+                    days = policy.logs_days
+                elif any(
+                    part.endswith(".trace") for part in relative.parts
+                ) or path.name.startswith(("trace.", "traces.")):
+                    days = policy.traces_days
+                else:
+                    continue
+                if job.get("status") == "failed":
+                    days = max(days, policy.failed_days)
+                stat = path.stat()
+                if now - stat.st_mtime < days * 86400:
+                    continue
+                if apply:
+                    path.unlink()
+                report["files"].append(str(relative))
+                report["bytes"] += stat.st_size
+    return report
