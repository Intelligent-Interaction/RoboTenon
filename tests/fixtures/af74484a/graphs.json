            "ltm_records": {
              "source": "inputs.ltm_records",
              "default": []
            }
          }
        },
        {
          "id": "action",
          "type": "module",
          "module": "xiaomi_robotics_1_action",
          "predecessors": [
            "plan"
          ],
          "next": [
            {
              "node": "body_execute"
            }
          ],
          "inputs": {
            "instruction": "nodes.plan.outputs.instruction",
            "env_steps": {
              "source": "nodes.evaluate.outputs.env_steps",
              "default": 0
            }
          }
        },
        {
          "id": "body_execute",
          "type": "system",
          "operation": "body.execute",
          "predecessors": [
            "action"
          ],
          "next": [
            {
              "node": "observe"
            }
          ]
        },
        {
          "id": "observe",
          "type": "system",
          "operation": "env.observe",
          "predecessors": [
            "body_execute"
          ],
          "next": [
            {
              "node": "verify"
            }
          ]
        },
        {
          "id": "verify",
          "type": "module",
          "module": "verify",
          "predecessors": [
            "observe"
          ],
          "next": [
            {
              "node": "evaluate"
            }
          ],
          "inputs": {
            "stm": "nodes.plan.outputs.stm",
            "instruction": "nodes.plan.outputs.instruction",
            "needs_plan": "nodes.action.outputs.needs_plan",
            "action_queue_remaining": "nodes.action.outputs.action_queue_remaining"
          }
        },
        {
          "id": "evaluate",
          "type": "module",
          "module": "robocasa365_terminal",
          "predecessors": [
            "verify"
          ],
          "default": "END",
          "goto": [
